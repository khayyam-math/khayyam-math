<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)">

<title>{{ topic.title }} | Khayyam Math</title>
<meta name="description" content="{{ topic.meta_description | trim }}">
<meta name="robots" content="index, follow">
<meta name="author" content="Khayyam Math">
<link rel="canonical" href="https://khayyammath.com/learn/{{ topic.slug }}">
<link rel="manifest" href="/manifest.json">

<!-- Open Graph -->
<meta property="og:type" content="article">
<meta property="og:title" content="{{ topic.title }}">
<meta property="og:description" content="{{ topic.subtitle }}">
<meta property="og:url" content="https://khayyammath.com/learn/{{ topic.slug }}">
<meta property="og:site_name" content="Khayyam Math">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="https://khayyammath.com/screenshots/social_preview.png">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ topic.title }}">
<meta name="twitter:description" content="{{ topic.subtitle }}">
<meta name="twitter:image" content="https://khayyammath.com/screenshots/social_preview.png">

<!-- WebPage + BreadcrumbList + LearningResource + FAQPage -->
<script type="application/ld+json">
{{ jsonld_blocks | safe }}
</script>

<style>
  :root {
    --bg: #fafafa;
    --fg: #1a1a1a;
    --muted: #555;
    --border: #e0e0e0;
    --accent: #2a6fd6;
    --code-bg: #f3f3f3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #1a1a1a;
      --fg: #f0f0f0;
      --muted: #aaa;
      --border: #2a2a2a;
      --accent: #79a9ff;
      --code-bg: #242424;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg); color: var(--fg);
    line-height: 1.55;
  }
  header { padding: 1.5em 2em; border-bottom: 1px solid var(--border); }
  header a.brand { font-weight: 700; color: var(--fg); text-decoration: none; }
  header nav { float: right; font-size: 0.95em; }
  header nav a { margin-left: 1.2em; color: var(--muted); text-decoration: none; }
  header nav a:hover { color: var(--accent); }
  main { max-width: 760px; margin: 0 auto; padding: 2em 2em 4em; }
  .breadcrumb { font-size: 0.9em; color: var(--muted); margin-bottom: 0.8em; }
  .breadcrumb a { color: var(--muted); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); }
  h1 { font-size: 2em; margin: 0 0 0.3em; line-height: 1.2; }
  .subtitle { font-size: 1.1em; color: var(--muted); margin-bottom: 1.6em; }
  .figure-frame {
    border: 1px solid var(--border); border-radius: 8px;
    padding: 1.2em; margin: 1.5em 0;
    background: #fff;
  }
  @media (prefers-color-scheme: dark) { .figure-frame { background: #222; } }
  .figure-frame svg { width: 100%; height: auto; display: block; }
  .try-live {
    display: inline-block; padding: 0.6em 1.2em; margin-top: 0.5em;
    background: var(--accent); color: white;
    border-radius: 6px; text-decoration: none; font-weight: 600;
  }
  .try-live:hover { opacity: 0.9; }
  h2 { font-size: 1.4em; margin-top: 2em; padding-bottom: 0.3em; border-bottom: 1px solid var(--border); }
  pre {
    background: var(--code-bg); padding: 0.8em 1em; border-radius: 6px;
    overflow-x: auto; font-size: 0.92em; line-height: 1.45;
  }
  details {
    border: 1px solid var(--border); border-radius: 6px;
    padding: 0.7em 1em; margin-bottom: 0.6em;
  }
  details summary { font-weight: 600; cursor: pointer; }
  details p { margin: 0.6em 0 0; color: var(--muted); font-size: 0.95em; }
  .related-list { padding-left: 1.2em; }
  .related-list li { margin: 0.3em 0; }
  footer {
    border-top: 1px solid var(--border); padding: 1.5em 2em;
    color: var(--muted); font-size: 0.9em; text-align: center;
  }
  footer a { color: var(--muted); }
</style>
</head>
<body>

<header>
  <a class="brand" href="/">Khayyam Math</a>
  <nav>
    <a href="/learn/">Topics</a>
    <a href="/">Home</a>
    <a href="/studio">Open the tutor</a>
  </nav>
</header>

<main>

  <div class="breadcrumb">
    <a href="/">Home</a> &rsaquo;
    <a href="/learn/">Learn</a> &rsaquo;
    {{ topic.title }}
  </div>

  <h1>{{ topic.title }}</h1>
  <p class="subtitle">{{ topic.subtitle }}</p>

  <div class="figure-frame">
    {{ topic_svg | safe }}
  </div>

  <p>
    <a class="try-live"
       href="/studio?prompt={{ topic.prompt | urlencode }}"
       title="Open the live tutor with this prompt">Try this live →</a>
  </p>

  <h2>What this shows</h2>
  {% for paragraph in topic.body_what_this_shows_paragraphs %}
    {% if '\n  ' in paragraph or paragraph.startswith('  ') -%}
    <pre>{{ paragraph }}</pre>
    {%- else -%}
    <p>{{ paragraph | safe }}</p>
    {%- endif %}
  {% endfor %}

  <h2>Where it shows up</h2>
  {% for paragraph in topic.body_applications_paragraphs %}
    <p>{{ paragraph | safe }}</p>
  {% endfor %}

  <h2>Frequently asked questions</h2>
  {% for qa in topic.faq %}
    <details>
      <summary>{{ qa.q }}</summary>
      <p>{{ qa.a }}</p>
    </details>
  {% endfor %}

  {% if related_topics %}
  <h2>Related topics</h2>
  <ul class="related-list">
    {% for r in related_topics %}
      <li><a href="/learn/{{ r.slug }}">{{ r.title }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}

</main>

<footer>
  <a href="/">Khayyam Math</a> &middot;
  <a href="https://github.com/khayyam-math/khayyam-math">GitHub</a> &middot;
  <a href="https://doi.org/10.5281/zenodo.20367147">Paper</a>
</footer>

</body>
</html>
