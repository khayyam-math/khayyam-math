# Khayyam Math — self-hosted stack configuration.
#
#   cp env.example .env && $EDITOR .env
#
# .env is gitignored.  This file replaces AWS Secrets Manager: every
# value the ECS task used to receive as an injected secret now lives
# here.  `deploy/selfhost/migrate_from_aws.sh --secrets` can copy the
# existing values out of Secrets Manager for you.
#
# Keep this file at mode 600 — it holds every credential the service has.


# ── Public identity ──────────────────────────────────────────────────
# The hostname served through the Cloudflare Tunnel.  Used to build
# magic-link URLs, so it must match what users type in the browser.
SEVIM_DOMAIN=khayyammath.com


# ── Cloudflare Tunnel ────────────────────────────────────────────────
# Created once in the Cloudflare dashboard:
#   Zero Trust → Networks → Tunnels → Create a tunnel → Docker
# Copy the long token out of the generated `docker run` command.
# This single value authenticates the tunnel; treat it as a secret.
CF_TUNNEL_TOKEN=


# ── Database (replaces the RDS-managed secret) ───────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=sevim
POSTGRES_PASSWORD=
POSTGRES_DB=sevim
# Host-side port for psql / pg_dump.  Bound to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432


# ── LLM backend (was Secrets Manager: sevim/openai) ──────────────────
OPENAI_API_KEY=


# ── Auth (was Secrets Manager: sevim/auth_secret, sevim/ip_hash_salt) ─
# Both are 32+ random bytes.  Reuse the EXISTING production values if
# you want live sessions to survive the cutover — a new auth secret
# invalidates every signed-in cookie and forces everyone to sign in
# again.  migrate_from_aws.sh --secrets copies them across.
#   python -c "import secrets; print(secrets.token_hex(32))"
SEVIM_AUTH_SECRET=
SEVIM_IP_HASH_SALT=


# ── Outbound mail (replaces SES) ─────────────────────────────────────
# Any SMTP relay works; Brevo's free tier is 300 emails/day.
#   Brevo:    smtp-relay.brevo.com : 587, user = your Brevo login,
#             password = an SMTP key from Brevo → SMTP & API → SMTP.
#   Resend:   smtp.resend.com : 587, user = "resend", password = API key.
#
# Leave SEVIM_SMTP_HOST empty to fall back to the SES backend, which is
# still in the code — that is the escape hatch if you revert to AWS.
SEVIM_SMTP_HOST=smtp-relay.brevo.com
SEVIM_SMTP_PORT=587
SEVIM_SMTP_USER=
SEVIM_SMTP_PASSWORD=
# Set to 1 for implicit TLS on port 465 instead of STARTTLS on 587.
SEVIM_SMTP_SSL=0

# The From address.  Its domain needs SPF + DKIM records pointing at
# your relay (see README.md §3) or mail lands in spam.
SEVIM_MAIL_FROM=noreply@khayyammath.com
SEVIM_MAIL_FROM_NAME=Khayyam Math
# Where the /contact form delivers.
SEVIM_CONTACT_TO=gradersystem@gmail.com


# ── Operator-only settings ───────────────────────────────────────────
# Admin dashboard whitelist — /studio/admin 404s for everyone not listed.
SEVIM_ADMIN_EMAILS=
# 6-hourly figure-quality probe + daily feedback digest.  These now run
# as systemd timers (see systemd/) rather than EventBridge schedules.
SEVIM_PROBE_ENABLED=1
SEVIM_PROBE_AUTOFIX=1
SEVIM_PROBE_ALERT_EMAIL=
SEVIM_FEEDBACK_DIGEST_ENABLED=1


# ── Runtime sizing ───────────────────────────────────────────────────
# Fargate ran 2 tasks × 3 GB.  This box has far more headroom; raise
# workers only if you have measured a queueing problem.
SEVIM_WORKERS=2
SEVIM_MEM_LIMIT=8g
APP_HOST_PORT=8080
