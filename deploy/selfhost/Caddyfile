# Khayyam Math — edge configuration for the self-hosted stack.
#
# This is the whole ALB + ACM + Route 53 replacement.  Caddy obtains a
# Let's Encrypt certificate for the names below on first start, renews it
# unattended, and redirects http:// to https:// automatically.
#
# Prerequisites, both of which fail loudly if missing:
#   * an A record for each name pointing at this host's public IP, and
#   * ports 80 and 443 reachable (provision.sh opens them in ufw).
# The ACME HTTP-01 challenge needs port 80 specifically; closing it after
# the first issuance breaks renewal 60 days later, which is a miserable
# thing to debug.
#
# Both the apex and www are served, because both currently resolve to the
# AWS load balancer and users have followed links to each.  They are one
# site block rather than a redirect so the cut-over changes nothing a
# visitor can observe; make www redirect to the apex later if you want
# one canonical cookie scope, by replacing the www name with:
#     www.{$SEVIM_DOMAIN} { redir https://{$SEVIM_DOMAIN}{uri} permanent }

{$SEVIM_DOMAIN}, www.{$SEVIM_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:8080 {
		# Stream responses through byte-for-byte as they are produced.
		#
		# This is load-bearing, not a tuning knob.  Figure generation is
		# served over SSE and the viewer paints from the first chunk; a
		# proxy that buffers turns a figure that starts appearing in
		# under a second into one that appears all at once at the end of
		# a turn, which reads as "the site hung".  It also starves the
		# 20-second SSE heartbeat that keeps long generations alive.
		flush_interval -1

		# OVERWRITE X-Forwarded-For with the real remote address.
		#
		# `caddy validate` warns this line is unnecessary because the
		# proxy already passes headers upstream.  Do not delete it on
		# that advice.  Caddy's default is to *append* to whatever the
		# client sent, and the app reads the LEFTMOST entry when
		# SEVIM_TRUST_PROXY=1 (studio/sessions.py:_client_ip).  So a
		# request arriving with a handwritten `X-Forwarded-For: 1.2.3.4`
		# becomes "1.2.3.4, <real ip>" and the app believes the forged
		# half — which is the input to rate limiting, the IP hash in
		# telemetry, and the geo lookup.  Overwriting makes the leftmost
		# entry the only entry, and it is the one Caddy observed.
		header_up X-Forwarded-For {remote_host}
	}

	# A generation turn can legitimately run to the 125 s perf cap, so no
	# response timeout is set: Caddy's default of "no limit" is correct
	# here.  Do not add one below that cap or the hardest prompts will
	# fail at the edge with the app still working.

	log {
		output stderr
		format console
	}
}

# Optional: an address for Let's Encrypt expiry warnings.  Uncomment and
# fill in, or leave it out — issuance works without one.
# {
# 	email you@example.com
# }
