[Unit]
Description=Run the Khayyam Math quality probe every 6 hours

[Timer]
# Matches the EventBridge rate(6 hours) schedule.
OnCalendar=*-*-* 00,06,12,18:00:00 UTC
# A missed window (box asleep, power cut) runs once on next boot rather
# than being silently skipped — Fargate's scheduler had no such gap.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
