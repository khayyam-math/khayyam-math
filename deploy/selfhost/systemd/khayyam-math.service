# Brings the whole stack up at boot and keeps it up.
#
# Replaces nothing in AWS directly — Fargate's desired-count did this
# implicitly.  On a self-hosted box something has to start the
# containers after a reboot or a power cut, and `restart: unless-stopped`
# in compose.yml only covers container-level crashes, not host restarts
# where the Docker daemon comes back with nothing running.
#
# Install:  sudo deploy/selfhost/systemd/install.sh

[Unit]
Description=Khayyam Math self-hosted stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ara/Documents/Programming/sevim_plugin/deploy/selfhost
User=ara
Group=ara
# --build is deliberately absent: boot should start the image that is
# already known-good, never silently rebuild from whatever is in the
# working tree.  Deploys are explicit (`./redeploy.sh`).
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
