# Nightly database + canvas backup.
#
# TEMPLATE — see khayyam-math.service.  Install via systemd/install.sh.
#
# There is no AWS counterpart to point at because this replaces two
# things at once: RDS automated backups and S3 object durability.  Both
# were free-by-default on AWS and are entirely our problem here.

[Unit]
Description=Khayyam Math nightly backup (database + canvas volume)
Requires=khayyam-math.service
After=khayyam-math.service

[Service]
Type=oneshot
WorkingDirectory=@@WORKDIR@@
User=@@USER@@
Group=@@USER@@
ExecStart=@@WORKDIR@@/backup.sh
TimeoutStartSec=3600
