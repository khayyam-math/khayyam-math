# Khayyam Math — environment variable template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# Lines starting with # are comments. Uncomment a line to activate it.


# ── LLM / figure generation ──────────────────────────────────────────────────

# Required for LLM figure generation, the template classifier, and vision review.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Anthropic key — used only for the /health endpoint check.
# The core figure pipeline does not require it.
# ANTHROPIC_API_KEY=sk-ant-...


# ── Text-to-speech / narration ────────────────────────────────────────────────

# "auto" prefers OpenAI TTS when OPENAI_API_KEY is set, falls back to
# local piper otherwise. Other values: "openai", "piper".
# SEVIM_TTS_BACKEND=auto

# OpenAI TTS model and voice (only used when SEVIM_TTS_BACKEND=openai or auto).
# SEVIM_TTS_MODEL=tts-1-hd
# SEVIM_TTS_VOICE=alloy

# Path to a local piper .onnx voice model (only used when SEVIM_TTS_BACKEND=piper or auto).
# Download from https://github.com/rhasspy/piper/releases
# SEVIM_VOICE_MODEL=~/.local/share/sevim/voices/en_US-lessac-medium.onnx


# ── Security controls — all OFF by default for local dev ─────────────────────
#
# WARNING: if you deploy this to a public server, enable all three.
# Without them your deployment is unauthenticated, unrate-limited,
# and accepts any prompt without content filtering.

# Require magic-link email login to access the Studio.
# When enabling, also set SEVIM_AUTH_SECRET.
# SEVIM_AUTH_REQUIRED=1

# 32+ random bytes used to sign login tokens and cookies.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required when SEVIM_AUTH_REQUIRED=1.
# SEVIM_AUTH_SECRET=

# Enable per-session and per-IP token-bucket rate limiting.
# SEVIM_RATE_LIMIT=1

# Enable per-session daily cost cap (default $1.00/session/day).
# Requires telemetry to be enabled.
# SEVIM_COST_GUARD=1

# Enable the regex-based content filter (blocks prompt-injection attempts,
# adult content, self-harm). Recommended for public deployments.
# SEVIM_CONTENT_FILTER=1


# ── Telemetry ─────────────────────────────────────────────────────────────────

# Enable telemetry logging.
# SEVIM_TELEMETRY=1

# SQLite path (dev) or PostgreSQL URL (prod).
# Default when unset: ~/.local/share/sevim/telemetry.db
# SEVIM_TELEMETRY_DB=./sevim.db
# SEVIM_TELEMETRY_DB=postgresql://user:pass@localhost:5432/sevim


# ── Backend / model selection ─────────────────────────────────────────────────

# URL of a local OpenAI-compatible vLLM server. Default: http://127.0.0.1:8000/v1
# SEVIM_VLLM_URL=http://127.0.0.1:8000/v1

# Model name to request from the vLLM server.
# SEVIM_VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# URL of a separate Qwen + LoRA vLLM endpoint (GPU instance).
# SEVIM_QWEN_VLLM_URL=http://your-gpu-host:8000/v1

# Auth key for the Qwen vLLM endpoint (if it requires one).
# SEVIM_QWEN_VLLM_KEY=

# Force a specific model id regardless of the admin UI setting.
# Useful for CI smoke runs or pinning a fine-tuned model atomically.
# SEVIM_FORCE_ACTIVE_MODEL=


# ── IP geolocation (optional) ─────────────────────────────────────────────────

# Path to a MaxMind GeoLite2-City .mmdb file for country/region/city lookup.
# Download from https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# SEVIM_GEOLITE_DB=/path/to/GeoLite2-City.mmdb

# Set to 1 when running behind an AWS ALB / CloudFront so that the real
# client IP is read from X-Forwarded-For. Leave 0 for local dev.
# SEVIM_TRUST_PROXY=0


# ── Route feature flags — all ON by default ───────────────────────────────────
#
# Set any of these to "off" to disable that route for debugging or A/B testing.
# You should not need to change these in normal development.
#
# SEVIM_TEMPLATE_ROUTER=on
# SEVIM_FDL_ROUTE=on
# SEVIM_GRAPHVIZ_ROUTE=on
# SEVIM_MATPLOTLIB_ROUTE=on
# SEVIM_SYMBOLIC_ROUTE=on
# SEVIM_ALGO_TRACE=on
# SEVIM_PROCESS_ROUTE=on
# SEVIM_HOMOM_ROUTE=on
# SEVIM_PANELS_ROUTE=on
# SEVIM_SEQUENTIAL_ROUTE=on
