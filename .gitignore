# Secrets / local config
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Test / benchmark outputs
out.svg
out.ir.json
out.trace.json
*.svg
*.pdf
*.log

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local Claude settings (project-specific, not for repo)
.claude/

# Paper-related directories — the manuscript and archived earlier
# versions live in the sevim-paper repository, NOT in the code
# repository. If a user runs a paper build inside this checkout
# (e.g. by cloning sevim-paper alongside it), the resulting tree
# must not be committed back here.
/paper/
/old/

# Generated LaTeX fragments + diagram examples (regenerate from
# pipeline / bench/eval/tables.py).
bench/eval/figs/

# CDK build artefacts — regenerated by every `cdk synth` / `cdk deploy`.
# Includes per-asset Docker contexts that can grow to hundreds of MB.
infra/cdk.out/
infra/cdk.context.json.bak
infra/__pycache__/

# Local distillation artefacts (corpora, LoRA adapters)
distill/
*.jsonl

# Neural-layout research artifacts (large data + model checkpoints).
# 990 MB combined; kept on the 5090 + S3, not in git.
data/neural_layout/
runs/
# v5 release artefacts ARE allowed back in (summary + post-mortem);
# the per-prompt SVGs / raw outputs stay ignored.
!runs/v5_practical_test/
!runs/v5_practical_test/*.md
!runs/v5_practical_test/*.json

# UAE IP-registration package — legal/business filing documents, not
# app code.  Kept out of the (soon-public) code repo: it carries the
# filing's contents and git history would make it permanent.
uae_ip_registration/

# v5 practical-test per-prompt artefacts (40 SVGs + 40 raw responses, ~800 KB).
# The summary.json and POSTMORTEM.md are kept tracked; the per-prompt
# files are too noisy for git and live alongside them in
# s3://<your-lora-bucket>/qwen_lora_v5_rejected/practical_test/
runs/v5_practical_test/*.svg
runs/v5_practical_test/*.raw.txt
