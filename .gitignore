# Secrets / local config
.env
.env.*
!.env.example

# MaxMind GeoLite2 database — refreshed at deploy time by
# infra/refresh_geolite.sh; the 60 MB binary must never enter git history.
infra/geolite/*.mmdb

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Test / benchmark outputs
out.svg
out.ir.json
out.trace.json
*.svg
*.pdf
*.log

# Jupyter
.ipynb_checkpoints/

# Pytest
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Local Claude settings (project-specific, not for repo)
.claude/

# Paper-related directories — the manuscript and archived earlier
# versions live in the sevim-paper repository, NOT in the code
# repository. If a user runs a paper build inside this checkout
# (e.g. by cloning sevim-paper alongside it), the resulting tree
# must not be committed back here.
/paper/
/old/

# Generated LaTeX fragments + diagram examples (regenerate from
# pipeline / bench/eval/tables.py).
bench/eval/figs/

# CDK build artefacts — regenerated by every `cdk synth` / `cdk deploy`.
# Includes per-asset Docker contexts that can grow to hundreds of MB.
infra/cdk.out/
infra/cdk.context.json.bak
infra/__pycache__/

# Local distillation artefacts (corpora, LoRA adapters)
distill/
*.jsonl

# Neural-layout research artifacts (large data + model checkpoints).
# 990 MB combined; kept on the 5090 + S3, not in git.
data/neural_layout/
runs/
# v5 release artefacts ARE allowed back in (summary + post-mortem);
# the per-prompt SVGs / raw outputs stay ignored.
!runs/v5_practical_test/
!runs/v5_practical_test/*.md
!runs/v5_practical_test/*.json

# UAE IP-registration package — legal/business filing documents, not
# app code.  Kept out of the (soon-public) code repo: it carries the
# filing's contents and git history would make it permanent.
uae_ip_registration/

# v5 practical-test per-prompt artefacts (40 SVGs + 40 raw responses,
# ~800 KB).  The summary.json and POSTMORTEM.md are kept tracked;
# the per-prompt files are too noisy for git and live alongside them
# in the operator's own S3 bucket configured via SEVIM_EXPORT_S3_BUCKET.
runs/v5_practical_test/*.svg
runs/v5_practical_test/*.raw.txt


# CDK cache file — contains the deployer's AWS account ID and
# Route 53 hosted-zone IDs.  Per-account; regenerated on first
# `cdk synth`.  Must never be committed to a public repo.
infra/cdk.context.json

# Private business / outreach drafts — not part of the open-source
# product surface; live in the repo for the author's convenience.
docs/application_openai_startup.md
docs/email_openai_education_contact.md

# Per-author dev journal — keeps a chronological record of what
# landed in each working session.  Useful locally for context
# continuity, but not part of the open-source product surface.
SESSION_STATE.md

# Brand logo assets are committed despite the blanket *.svg ignore above.
!service/static/logo.svg
!service/static/logo-badge.svg

# Artifact written by examples/three_tiers.py
examples/tier3_reduction.svg
